{
  "name": "@aura/web",
  "version": "1.0.0",
  "description": "Aura Agent 配置与运行控制台",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "dev": "npm run build:client && tsx watch src/index.ts",
    "dev:client": "vite",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@aura/host": "*",
    "@aura/protocol": "*",
    "@aura/router": "*",
    "@aura/worker": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
